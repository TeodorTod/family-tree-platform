generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartnerStatus {
  MARRIED
  DIVORCED
  SEPARATED
  WIDOWED
  ENGAGED
  PARTNERS
  FRIENDS
  ANNULLED
  UNKNOWN
  OTHER
}

enum ShareRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String?
  displayName String?
  picture     String?
  provider    String?
  language    String    @default("bg")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  familyMembers          FamilyMember[]
  PasswordResetToken     PasswordResetToken[]
  userSettings           UserSettings?
  memberShareConsents    MemberShareConsent[]
  shareRequestsRequested ShareRequest[]       @relation("RequesterUser")
  shareRequestsDecided   ShareRequest[]       @relation("DecidedByUser")
}

model FamilyMember {
  id             String    @id @default(uuid())
  userId         String
  firstName      String
  middleName     String?
  lastName       String
  gender         String?
  dob            DateTime?
  birthYear      Int?
  birthNote      String?
  dod            DateTime?
  deathYear      Int?
  deathNote      String?
  isAlive        Boolean   @default(true)
  photoUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt
  role           String
  relationLabel  String?
  translatedRole String?

  partnerId     String?        @unique
  partner       FamilyMember?  @relation("MemberPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerOf     FamilyMember[] @relation("MemberPartner")
  partnerStatus PartnerStatus?

  /// back‐relation to MemberProfile (one-to-one)
  profile MemberProfile? @relation("ProfileToMember")

  copiedFromMemberId String?
  copiedFromMember   FamilyMember?  @relation("CopiedFrom", fields: [copiedFromMemberId], references: [id], onDelete: SetNull)
  copiedClones       FamilyMember[] @relation("CopiedFrom")
  copiedSnapshotAt   DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentOf            Relationship[]       @relation("ParentChildFrom")
  childOf             Relationship[]       @relation("ParentChildTo")
  media               Media[]
  memberShareConsents MemberShareConsent[]
  shareRequests       ShareRequest[]

  @@unique([userId, role], name: "user_role_unique")
  @@index([userId])
  @@index([isAlive])
  @@index([dod])
  @@index([deathYear])
  @@index([copiedFromMemberId])
}

model Relationship {
  id           String   @id @default(uuid())
  fromMemberId String
  toMemberId   String
  type         String
  createdAt    DateTime @default(now())

  fromMember FamilyMember @relation("ParentChildFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   FamilyMember @relation("ParentChildTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([fromMemberId, toMemberId, type], name: "edge_once") // <-- NEW
  @@index([fromMemberId])
  @@index([toMemberId])
}

model Media {
  id         String   @id @default(uuid())
  memberId   String
  url        String
  type       String
  caption    String?
  uploadedAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model MemberProfile {
  /// PK
  id String @id @default(uuid())

  /// FK → FamilyMember.id (one-to-one)
  memberId String       @unique
  member   FamilyMember @relation("ProfileToMember", fields: [memberId], references: [id], onDelete: Cascade)

  /// long-form biography
  bio String?

  /// headline media URL
  coverMediaUrl String?

  /// lists & blobs as JSONB
  achievements Json? // e.g. [ { title: "Eagle Scout", year: 1999 }, … ]
  facts        Json? // e.g. { birthplace: "Sofia", nickname: "Gosho" }
  favorites    Json? // e.g. { books: [...], movies: [...], places: [...] }
  education    Json? // e.g. [ { school: "...", degree: "...", from: "...", to: "..." }, … ]
  work         Json? // e.g. [ { company: "...", title: "...", from: "...", to: "..." }, … ]
  stories      Json? // e.g. [ { date: "...", text: "..." }, … ]
  personalInfo Json? // e.g. { email: "...", phone: "...", website: "..." }
  notes        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  id                            String    @id @default(uuid())
  userId                        String    @unique
  allowDeceasedDiscoveryDefault Boolean   @default(true)
  allowDeceasedDetailsDefault   Boolean   @default(false)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime? @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MemberShareConsent {
  id             String    @id @default(uuid())
  ownerUserId    String
  memberId       String
  allowDiscovery Boolean   @default(true)
  allowDetails   Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  owner  User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, memberId])
}

model ShareRequest {
  id              String             @id @default(uuid())
  requesterUserId String
  targetMemberId  String
  status          ShareRequestStatus @default(PENDING)
  message         String?
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime?          @updatedAt

  requester User         @relation("RequesterUser", fields: [requesterUserId], references: [id], onDelete: Cascade)
  target    FamilyMember @relation(fields: [targetMemberId], references: [id], onDelete: Cascade)
  decidedBy User?        @relation("DecidedByUser", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([requesterUserId])
  @@index([targetMemberId])
  @@index([status])
}
