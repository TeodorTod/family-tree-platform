# Local development values only. Never commit a populated .env file.
PORT=3000
DATABASE_URL=postgresql://app_user:replace-me@localhost:5432/family_tree?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://example.invalid
MEDIA_ROOT=./runtime-media

# Optional integrations. Leave blank to keep the related feature disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://example.invalid
BREVO_API_KEY=
BREVO_SENDER_EMAIL=redacted@example.invalid
BREVO_SENDER_NAME=Family Tree Platform
BREVO_REPLYTO_EMAIL=
BREVO_REPLYTO_NAME=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SIX_MONTHS=
STRIPE_PRICE_ONE_YEAR=
STRIPE_PRICE_TWO_YEARS=
CONTACT_FORM_RECIPIENT=redacted@example.invalid
