generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String?
  displayName String?
  picture     String?
  provider    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
}
